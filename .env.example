APP_NAME="MR. LANA PEOPLE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# En produccion: https://people.mr-lana.com (sobreescribir con localhost en .env local).
APP_URL=https://people.mr-lana.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# Feature flags del portal (ver config/features.php y docs/FEATURE_FLAGS.md).
# Capacitacion no se elimino: solo queda oculta hasta la Fase 5 del roadmap.
RH_PORTAL_ENABLED=true
CAPACITACION_ENABLED=false
DESEMPENO_ENABLED=false
NINE_BOX_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# En desarrollo con WAMP se recomienda mariadb/mysql (no sqlite), para reflejar el motor real de produccion.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capacitaciones
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Cola "database" es valida para desarrollo; en produccion se recomienda Redis (ver docs/COLAS_Y_SCHEDULER.md).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local, MAIL_MAILER=log basta (los correos quedan en storage/logs/laravel.log).
# Antes de usar el envio de contraseñas por correo (Administracion > Usuarios /
# expediente > Cuenta) en un ambiente real, cambia a smtp y llena host/puerto/
# usuario/password reales de tu proveedor (Gmail, SendGrid, Mailgun, tu propio
# hosting, etc.) — nunca se versionan credenciales reales aqui.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notificaciones@mr-lana.com"
MAIL_FROM_NAME="${APP_NAME}"
# Ejemplo para produccion via SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.tu-proveedor.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-usuario
# MAIL_PASSWORD=tu-password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==================================================================
# Las siguientes variables corresponden a fases posteriores del
# proyecto (biblioteca multimedia/NAS, video, sesiones en vivo,
# notificaciones). Se documentan desde ahora para no reabrir este
# archivo varias veces, pero permanecen sin activar hasta su fase.
# Ver docs/PLAN_IMPLEMENTACION.md para el detalle de cada fase.
# ==================================================================

# --- Almacenamiento NAS ---
# Disco compartido por biblioteca multimedia, expedientes/documentos e
# incorporacion (todos via Storage::disk('nas'), ver docs/CONFIGURACION_NAS.md).
# En produccion: Synology conectado al VPS por Tailscale y montado en
# /mnt/people-storage (sigue siendo driver=local desde el punto de vista de
# Laravel/Flysystem).
NAS_DRIVER=local
NAS_ROOT=/mnt/people-storage
# NAS_HOST=
# NAS_PORT=22
# NAS_USERNAME=
# NAS_PASSWORD=
# NAS_PRIVATE_KEY=
# NAS_PATH_PREFIX=

# --- Expedientes / incorporacion documental ---
EXPEDIENTES_MAX_UPLOAD_MB=20

# --- Incorporacion por QR temporal (docs/API_MOVIL.md, "Registro por QR temporal") ---
INCORPORACION_QR_TTL_HOURS=72
INCORPORACION_QR_URL_BASE=https://people.mr-lana.com/incorporacion/qr

# --- App movil v5 (docs/BACKEND_MOBILE_V5.md) ---
APP_MOBILE_MIN_VERSION=1.0.0
APP_MOBILE_LATEST_VERSION=1.0.0
APP_MOBILE_FORCE_UPDATE=false
APP_MOBILE_MAINTENANCE=false
# APP_MOBILE_MAINTENANCE_MESSAGE=
APP_MOBILE_RH_ENABLED=true
APP_MOBILE_BIOMETRICS_ENABLED=true
APP_MOBILE_QR_ONBOARDING_ENABLED=true
# Version minima por plataforma (GET /api/v1/app/config). Android usa
# APP_MOBILE_MIN_VERSION si no se define APP_MOBILE_MIN_ANDROID_VERSION.
# APP_MOBILE_MIN_ANDROID_VERSION=1.0.0
# APP_MOBILE_MIN_ANDROID_BUILD=1
# iOS queda null hasta que exista distribucion real (TestFlight/App Store).
# APP_MOBILE_MIN_IOS_VERSION=
# APP_MOBILE_MIN_IOS_BUILD=

# --- Push notifications via Expo (docs/PUSH_NOTIFICATIONS.md) ---
EXPO_PUSH_ENABLED=true
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send

# --- Notificaciones en tiempo real del portal web (Laravel Reverb, docs/PUSH_NOTIFICATIONS.md) ---
# Self-hosted (sin cuenta externa): el mismo servidor corre `php artisan reverb:start`
# como proceso supervisado (ver deploy/), detras de Nginx con proxy_pass a wss://.
# En produccion: REVERB_HOST=people.mr-lana.com, REVERB_PORT=443, REVERB_SCHEME=https,
# y Nginx debe reenviar /app/* al puerto interno de Reverb (ver deploy/nginx).
REVERB_APP_ID=change-me
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Procesamiento de video (Fase 3) ---
# FFMPEG_BIN=/usr/bin/ffmpeg
# FFPROBE_BIN=/usr/bin/ffprobe
# MEDIA_TOKEN_TTL=600
# MEDIA_ALLOWED_ORIGIN=
# MEDIA_MAX_UPLOAD_MB=
# VIDEO_COMPLETION_PERCENT=98
# VIDEO_HEARTBEAT_SECONDS=8
# VIDEO_PLAYBACK_RATE=1

# --- X-Accel-Redirect / Nginx (Fase 9) ---
# Solo activar en producción, detrás de Nginx, con deploy/nginx/multimedia.conf
# ya aplicado. En este entorno de desarrollo (WAMP, sin Nginx) debe quedar en
# false: el streaming directo por PHP sigue siendo correcto, solo más lento.
# MEDIA_X_ACCEL_REDIRECT=false
# MEDIA_X_ACCEL_INTERNAL_PREFIX=/protegido-nas

# --- Carga de video por bloques reanudable (Fase 9) ---
# MEDIA_CHUNK_SIZE_MB=8
# MEDIA_CARGA_EXPIRA_HORAS=24

# --- Google Meet (Fase 5, ampliado en Fase 9 con sincronización de asistencia) ---
# GOOGLE_MEET_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_SERVICE_ACCOUNT_PATH=
# GOOGLE_IMPERSONATED_USER=
# GOOGLE_WORKSPACE_CUSTOMER_ID=
# GOOGLE_CALENDAR_ID=primary

# --- Zoom (Fase 5, ampliado en Fase 9 con reportes y webhooks) ---
# ZOOM_ENABLED=false
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_WEBHOOK_SECRET=
# ZOOM_HOST_EMAIL=

# --- Telegram (preparado para segunda fase de notificaciones) ---
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DEFAULT_CHAT_ID=

# --- Modulo de cumpleanos (docs/CUMPLEANOS.md) ---
CUMPLEANOS_ENABLED=true
CUMPLEANOS_NOTIFY_EMPLOYEE=true
CUMPLEANOS_NOTIFY_RH=true
CUMPLEANOS_CARD_WIDTH=1080
CUMPLEANOS_CARD_HEIGHT=1350
CUMPLEANOS_CARD_BACKGROUND=#FFF8E7
CUMPLEANOS_SHOW_BRANCH=true
CUMPLEANOS_SHOW_PHOTO=true
CUMPLEANOS_SHOW_AGE=false
CUMPLEANOS_AUTO_GENERATE_CARDS=true

# --- Descarga de app / APK (docs/APP_RELEASES.md) ---
MOBILE_APP_DOWNLOAD_ENABLED=true
MOBILE_APK_MAX_MB=250
